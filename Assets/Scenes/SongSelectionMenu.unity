  difficultyDescription: {fileID: 1846887582}
  easyModeDescription: This game can be seemingly overwhelming for first timers.
    Highly recommend.
  easyModeColor: {r: 0.32156864, g: 0.7803922, b: 0.8000001, a: 1}
